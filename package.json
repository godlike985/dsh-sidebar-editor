{
  "name": "dsh-sidebar-editor",
  "version": "0.1.0",
  "description": "Preview code files in the right Sidebar document tab, search workspace files by name, and reference the selected lines into the composer.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godlike985/dsh-sidebar-editor.git"
  },
  "homepage": "https://github.com/godlike985/dsh-sidebar-editor#readme",
  "bugs": {
    "url": "https://github.com/godlike985/dsh-sidebar-editor/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-ui",
    "sidebar",
    "code",
    "reference",
    "search"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
